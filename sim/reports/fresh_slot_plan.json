 "estimator": "per-OPPONENT mean of P(win) (round-robin functional). CI by Jeffreys per cell and bootstrap over teams. Textbook binomial variance is FORBIDDEN: it assigns exactly zero variance to cells at p=1, which is the error that made a previous 69.5%% lower bound look like it cleared the threshold.",
 "filters": [
  "is_contest(): drop games where the opponent finished on a NEGATIVE net score - a broken slot is not a defeat; print the count and the list"
 ],
 "frozen_at_utc": "2026-08-10T16:47:17.505345+00:00",
 "map_counts": {
  "1": 14,
  "2": 14,
  "3": 14
 },
 "n_teams": 42,
 "prereg_bias_direction": {
  "claim": "fresh-slot teams are STRONGER than stale-slot teams on the ladder, so this sample is the stronger half of the field and the estimate is CONSERVATIVE (biased DOWN).",
  "consequence": "if the lower bound still clears the threshold, the conclusion is hard; if it fails, part of the failure is attributable to facing the stronger half.",
  "measured_before_the_run": {
   "difference": 0.076,
   "fresh_mean_ladder_win_rate": 0.527,
   "fresh_n": 35,
   "se": 0.042,
   "sigma": 1.79,
   "stale_mean_ladder_win_rate": 0.451,
   "stale_n": 49
  }
 },
 "prereg_falsification": {
  "above": "Jeffreys/bootstrap 95%% lower bound > threshold at read time => 'likely to qualify'",
  "below": "95%% upper bound < threshold => 'likely not to qualify'",
  "undecided": "otherwise => STILL UNDECIDED, and in that case write explicitly that the bias-avoiding design has been exhausted and our position is not决-able before the qualifier. That is a terminal conclusion, not a failure."
 },
 "purpose": "constructively remove the staleness bias instead of correcting for it: challenge only opponents whose PUBLIC slot was refreshed within 24h, so slot ~= current code and the active condition approximates the qualifier",
 "reanalysis_rule": "the roster is NOT redrawn if release is delayed. Instead each game records the team's slot age AT SUBMISSION, so the analysis can condition on actual freshness; teams that age past 24h before play are reported, not silently replaced.",
 "selection_rule": "get_model_list_4 updated_at within 24h of freeze; exclude user_id 2/3/4 (organiser test accounts) and 220 (ourselves); one game per team; map = (index mod 3)+1 over ascending user_id",
 "submission_rule": "STRICTLY SERIAL - one game at a time, wait for completion before the next. Concurrent submission was measured to inflate our own P50 by 4.1x and P90 by 4.7x, and this batch is also the clean latency read.",
 "threshold_note": "rank 16's 24h rolling win rate; NOT a constant (observed 0.6756 / 0.6731 / 0.6780 within forty minutes). Record value AND read time at analysis."
}
